# BidCognix Environment Configuration

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# PostgreSQL Connection Configuration
# Option 1: Full Connection String
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bidcognix

# Option 2: Individual Connection Parameters
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=bidcognix

# BidCognix AI Microservice URL (FastAPI)
AI_FASTAPI_URL=http://127.0.0.1:8000

# JWT Authentication Secret
JWT_SECRET=bidcognix_jwt_secret_key_change_in_production_2026

# Optional Gemini Integration Key (Core tender workflow is 100% functional without it)
# GEMINI_API_KEY=your_gemini_api_key_here
